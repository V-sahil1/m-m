# Copy this file to .env and fill in the values. Never commit .env.

# The Gmail account the emails are sent from
GMAIL_USER=you@gmail.com

# A 16-character Google "app password" (not your normal Gmail password).
# Create one at https://myaccount.google.com/apppasswords (2-Step Verification must be on).
GMAIL_APP_PASSWORD=

# Optional: where new-reservation notices are sent. Defaults to GMAIL_USER.
# OWNER_EMAIL=

# Optional: port for the reservation server. Defaults to 3001.
# PORT=3001
